/* check catching specific types of exceptions
 */
CREATE TABLE specific (
    i integer PRIMARY KEY
);
CREATE FUNCTION specific_exception(i integer) RETURNS void AS
$$
try
  let i_sql = match i with
    | PL.Null -> "NULL"
    | PL.Int n -> string_of_int n
    | _ -> "NULL"
  in
  ignore (PL.execute (Printf.sprintf "insert into specific values (%s)" i_sql));
  ()
with Failure ex ->
  if String.contains ex 'n' || true then
    PL.notice ("SPI error: " ^ ex);
  ()
$$ LANGUAGE plocamlu;
SELECT specific_exception(2);
 specific_exception 
--------------------
 
(1 row)

SELECT specific_exception(NULL);
NOTICE:  SPI error: null value in column "i" of relation "specific" violates not-null constraint
 specific_exception 
--------------------
 
(1 row)

SELECT specific_exception(2);
NOTICE:  SPI error: duplicate key value violates unique constraint "specific_pkey"
 specific_exception 
--------------------
 
(1 row)

/* SPI errors in PL/OCaml functions should preserve the SQLSTATE value
 */
CREATE FUNCTION ocaml_unique_violation() RETURNS void AS $$
ignore (PL.execute "insert into specific values (1)");
ignore (PL.execute "insert into specific values (1)");
()
$$ LANGUAGE plocamlu;
CREATE FUNCTION catch_ocaml_unique_violation() RETURNS text AS $$
begin
    begin
        perform ocaml_unique_violation();
    exception when unique_violation then
        return 'ok';
    end;
    return 'not reached';
end;
$$ language plpgsql;
SELECT catch_ocaml_unique_violation();
ERROR:  duplicate key value violates unique constraint "specific_pkey"
CONTEXT:  Traceback (most recent call last):
  PL/OCaml function "ocaml_unique_violation", line 3, in <function>
PL/OCaml function "ocaml_unique_violation"

/* Calling PL/OCaml functions from SQL and vice versa should not lose context.
 */
CREATE OR REPLACE FUNCTION ocaml_traceback() RETURNS void AS $$
let rec first () = second (); ()
and second () = third (); ()
and third () = ignore (PL.execute "select sql_error()")
in
first ();
()
$$ LANGUAGE plocamlu;
CREATE OR REPLACE FUNCTION sql_error() RETURNS void AS $$
begin
  select 1/0;
end
$$ LANGUAGE plpgsql;
CREATE OR REPLACE FUNCTION ocaml_from_sql_error() RETURNS void AS $$
begin
  select ocaml_traceback();
end
$$ LANGUAGE plpgsql;
CREATE OR REPLACE FUNCTION sql_from_ocaml_error() RETURNS void AS $$
ignore (PL.execute "select sql_error()");
()
$$ LANGUAGE plocamlu;

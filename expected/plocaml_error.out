/* a typo
 */
CREATE FUNCTION invalid_type_uncaught(a text) RETURNS text
	AS $$
if not (Hashtbl.mem sd "plan") then
  PL.set sd "plan" (PL.prepare "SELECT fname FROM users WHERE lname = $1" [|"test"|]);
let rv = PL.execute_plan (PL.get sd "plan") [| a |] in
if Array.length rv.rows > 0 then List.assoc "fname" rv.rows.(0)
else PL.Null
$$ LANGUAGE plocamlu;
SELECT invalid_type_uncaught('rick');
ERROR:  type "test" does not exist
CONTEXT:  Traceback (most recent call last):
  PL/OCaml function "invalid_type_uncaught", line 3, in <function>
PL/OCaml function "invalid_type_uncaught"
/* for what it's worth catch the exception generated by
 * the typo, and return None
 */
CREATE FUNCTION invalid_type_caught(a text) RETURNS text
	AS $$
if not (Hashtbl.mem sd "plan") then
  (try
    PL.set sd "plan" (PL.prepare "SELECT fname FROM users WHERE lname = $1" [|"test"|])
  with Failure ex ->
    PL.notice ex);
if not (Hashtbl.mem sd "plan") then PL.Null
else
  let rv = PL.execute_plan (PL.get sd "plan") [| a |] in
  if Array.length rv.rows > 0 then List.assoc "fname" rv.rows.(0)
  else PL.Null
$$ LANGUAGE plocamlu;
SELECT invalid_type_caught('rick');
NOTICE:  type "test" does not exist
 invalid_type_caught 
---------------------
 
(1 row)

/* for what it's worth catch the exception generated by
 * the typo, and reraise it as a plain error
 */
CREATE FUNCTION invalid_type_reraised(a text) RETURNS text
	AS $$
if not (Hashtbl.mem sd "plan") then
  (try
    PL.set sd "plan" (PL.prepare "SELECT fname FROM users WHERE lname = $1" [|"test"|])
  with Failure ex ->
    PL.error ex);
let rv = PL.execute_plan (PL.get sd "plan") [| a |] in
if Array.length rv.rows > 0 then List.assoc "fname" rv.rows.(0)
else PL.Null
$$ LANGUAGE plocamlu;
SELECT invalid_type_reraised('rick');
ERROR:  type "test" does not exist
CONTEXT:  Traceback (most recent call last):
  PL/OCaml function "invalid_type_reraised", line 6, in <function>
PL/OCaml function "invalid_type_reraised"
/* no typo no messing about
 */
CREATE FUNCTION valid_type(a text) RETURNS text
	AS $$
if not (Hashtbl.mem sd "plan") then
  PL.set sd "plan" (PL.prepare "SELECT fname FROM users WHERE lname = $1" [|"text"|]);
let rv = PL.execute_plan (PL.get sd "plan") [| a |] in
if Array.length rv.rows > 0 then List.assoc "fname" rv.rows.(0)
else PL.Null
$$ LANGUAGE plocamlu;
SELECT valid_type('rick');
 valid_type 
------------
 
(1 row)

/* error in nested functions to get a traceback
*/
CREATE FUNCTION nested_error() RETURNS text
	AS $$
let rec fun1 () = PL.error "boom"; ()
and fun2 () = fun1 (); ()
and fun3 () = fun2 (); ()
in
fun3 ();
PL.String "not reached"
$$ LANGUAGE plocamlu;
SELECT nested_error();
ERROR:  boom
CONTEXT:  Traceback (most recent call last):
  PL/OCaml function "nested_error", line 6, in <function>
  PL/OCaml function "nested_error", line 4, in fun3
  PL/OCaml function "nested_error", line 3, in fun2
  PL/OCaml function "nested_error", line 2, in fun1
PL/OCaml function "nested_error"
/* raising Failure is just like calling PL.error
*/
CREATE FUNCTION nested_error_raise() RETURNS text
	AS $$
let rec fun1 () = failwith "boom"; ()
and fun2 () = fun1 (); ()
and fun3 () = fun2 (); ()
in
fun3 ();
PL.String "not reached"
$$ LANGUAGE plocamlu;
SELECT nested_error_raise();
ERROR:  boom
CONTEXT:  Traceback (most recent call last):
  PL/OCaml function "nested_error_raise", line 6, in <function>
  PL/OCaml function "nested_error_raise", line 4, in fun3
  PL/OCaml function "nested_error_raise", line 3, in fun2
  PL/OCaml function "nested_error_raise", line 2, in fun1
PL/OCaml function "nested_error_raise"
/* using PL.warning should not produce a traceback
*/
CREATE FUNCTION nested_warning() RETURNS text
	AS $$
let rec fun1 () = PL.warning "boom"
and fun2 () = fun1 ()
and fun3 () = fun2 ()
in
fun3 ();
PL.String "you've been warned"
$$ LANGUAGE plocamlu;
SELECT nested_warning();
WARNING:  boom
   nested_warning   
--------------------
 you've been warned

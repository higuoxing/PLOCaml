/* manually starting subtransactions - a bad idea
 */
CREATE FUNCTION manual_subxact() RETURNS void AS $$
ignore (PL.execute "savepoint save");
ignore (PL.execute "create table foo(x integer)");
ignore (PL.execute "rollback to save");
()
$$ LANGUAGE plocamlu;
SELECT manual_subxact();
ERROR:  SPI_execute failed with status code -8
CONTEXT:  Traceback (most recent call last):
  PL/OCaml function "manual_subxact", line 2, in <function>
PL/OCaml function "manual_subxact"
/* same for prepared plans
 */
CREATE FUNCTION manual_subxact_prepared() RETURNS void AS $$
let save = PL.prepare "savepoint save" [||] in
let rollback = PL.prepare "rollback to save" [||] in
ignore (PL.execute_plan save [||]);
ignore (PL.execute "create table foo(x integer)");
ignore (PL.execute_plan rollback [||]);
()
$$ LANGUAGE plocamlu;
SELECT manual_subxact_prepared();
ERROR:  SPI_execute_plan failed with status code -8
CONTEXT:  Traceback (most recent call last):
  PL/OCaml function "manual_subxact_prepared", line 4, in <function>
PL/OCaml function "manual_subxact_prepared"
/* test the context stack trace for nested execution levels
 */
CREATE FUNCTION notice_innerfunc() RETURNS int AS $$
ignore (PL.execute "DO LANGUAGE plocamlu $x$ PL.notice \"inside DO\" $x$");
PL.Int 1
$$ LANGUAGE plocamlu;
CREATE FUNCTION notice_outerfunc() RETURNS int AS $$
ignore (PL.execute "SELECT notice_innerfunc()");
PL.Int 1
$$ LANGUAGE plocamlu;
SELECT notice_outerfunc();
NOTICE:  inside DO
 notice_outerfunc 
------------------
                1
(1 row)

/* test error logged with an underlying exception that includes a detail
 * string (bug #18070).
 */
CREATE FUNCTION ocaml_error_detail() RETURNS SETOF text AS $$
  let plan = PL.prepare "SELECT to_date('xy', 'DD') d" [||] in
  let cur = PL.cursor_plan plan [||] in
  let rec acc xs =
    let batch = PL.fetch cur 1 in
    if batch.nrows = 0 then List.rev xs
    else acc (List.assoc "d" batch.rows.(0) :: xs)
  in
  PL.Array (Array.of_list (acc []))
$$ LANGUAGE plocamlu;
SELECT ocaml_error_detail();
ERROR:  invalid value "xy" for "DD"
CONTEXT:  Traceback (most recent call last):
  PL/OCaml function "ocaml_error_detail", line 9, in <function>
  PL/OCaml function "ocaml_error_detail", line 5, in acc
PL/OCaml function "ocaml_error_detail"

CREATE FUNCTION pk_violation_inside_subtransaction() RETURNS void
AS $$
PL.subtransaction (fun () ->
  ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
  try
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)")
  with Failure _ ->
    PL.notice "caught"
);
()
$$ LANGUAGE plocamlu;

DROP TABLE subtransaction_tbl;
-- cursor/subtransactions interactions
CREATE FUNCTION cursor_in_subxact() RETURNS int AS $$
let cur = ref None in
PL.subtransaction (fun () ->
  let c = PL.cursor "select * from generate_series(1, 20) as gen(i)" in
  ignore (PL.fetch c 10);
  cur := Some c
);
let fetched = PL.fetch (Option.get !cur) 10 in
PL.Int (PL.to_int_exn (List.assoc "i" fetched.rows.(5)))
$$ LANGUAGE plocamlu;
CREATE FUNCTION cursor_aborted_subxact() RETURNS int AS $$
let cur = ref None in
(try
  PL.subtransaction (fun () ->
    let c = PL.cursor "select * from generate_series(1, 20) as gen(i)" in
    ignore (PL.fetch c 10);
    cur := Some c;
    ignore (PL.execute "select no_such_function()")
  );
  PL.Int 0
with Failure _ ->
  let fetched = PL.fetch (Option.get !cur) 10 in
  PL.Int (PL.to_int_exn (List.assoc "i" fetched.rows.(5))))
$$ LANGUAGE plocamlu;
CREATE FUNCTION cursor_plan_aborted_subxact() RETURNS int AS $$
let cur = ref None in
(try
  PL.subtransaction (fun () ->
    ignore (PL.execute "create temporary table tmp(i) as select generate_series(1, 10)");
    let plan = PL.prepare "select i from tmp" [||] in
    cur := Some (PL.cursor_plan plan [||]);
    ignore (PL.execute "select no_such_function()")
  );
  PL.Int 0
with Failure _ ->
  let fetched = PL.fetch (Option.get !cur) 5 in
  PL.Int (PL.to_int_exn (List.assoc "i" fetched.rows.(2))))
$$ LANGUAGE plocamlu;
CREATE FUNCTION cursor_close_aborted_subxact() RETURNS boolean AS $$
let cur = ref None in
(try
  PL.subtransaction (fun () ->
    cur := Some (PL.cursor "select 1");
    ignore (PL.execute "select no_such_function()")
  );
  PL.Bool false
with Failure _ ->
  PL.close (Option.get !cur);
  PL.Bool true)
$$ LANGUAGE plocamlu;
SELECT cursor_in_subxact();

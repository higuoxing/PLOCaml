-- Nested subtransactions
CREATE FUNCTION subtransaction_nested_test(swallow boolean = 'f') RETURNS text
AS $$
ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
PL.subtransaction (fun () ->
  ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (2)");
  try
    PL.subtransaction (fun () ->
      ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (3)");
      ignore (PL.execute "error")
    )
  with Failure e ->
    if not (PL.to_bool ~default:false swallow) then failwith e
    else PL.notice (Printf.sprintf "Swallowed Failure(%S)" e)
);
PL.String "ok"
$$ LANGUAGE plocamlu;
SELECT subtransaction_nested_test();

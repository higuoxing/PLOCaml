-- Ported from PostgreSQL src/pl/plpython/sql/plpython_subtransaction.sql (REL_16_STABLE).
-- Python context-manager protocol tests (__enter__/__exit__) have no OCaml
-- analog and are omitted; PL.subtransaction is a function taking a thunk.
-- Test table to see if transactions get properly rolled back
CREATE TABLE subtransaction_tbl (
    i integer
);
CREATE FUNCTION subtransaction_ctx_test(what_error text = NULL) RETURNS text
AS $$
(try
  PL.subtransaction (fun () ->
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (2)");
    match what_error with
    | PL.String "SPI" ->
        ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES ('oops')")
    | PL.String "Python" ->
        failwith "Python exception"
    | _ -> ()
  );
  PL.String "ok"
with Failure _ -> PL.String "error")
$$ LANGUAGE plocamlu;
SELECT subtransaction_ctx_test();
 subtransaction_ctx_test 
-------------------------
 ok
(1 row)

